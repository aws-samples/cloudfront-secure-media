# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS / editor
.DS_Store
.vscode/*

# Dependencies (defensive catch-all; subfolders also ignore their own)
node_modules/

# Build output
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local agent/working files (plans, steering, settings) - not part of the sample
.claude/
.kiro/

# The application (frontend + Amplify backend) lives under frontend/ and has its
# own .gitignore. See frontend/.gitignore for app- and Amplify-specific rules.
docs/BLOG.md
