# Dependencies
node_modules/
/.pnp
.pnp.js

# Production build
/build
build/
dist/

# Env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lockfile (intentionally not committed for this sample)
package-lock.json

# runtime-config.json is generated (deploy-specific Cognito/CloudFront values) and
# must never be committed. The committed runtime-config.example.json is the template;
# `npm run seed-config` (auto-run before dev/build) copies it in when absent, and the
# foundation deploy (foundation/scripts/write-frontend-config.mjs) overwrites it with
# real values locally.
public/runtime-config.json
